# Discord is required in normal mode. It is not required for --dry-run or --fixture.
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
DISCORD_ALLOWED_USER_IDS=

APP_TIMEZONE=Asia/Tokyo
BRIEF_CRON=0 8 * * *
DATABASE_PATH=data/bot.db
LOG_LEVEL=info
HTTP_USER_AGENT=DiscordComputerNewsBot/1.0 (+https://github.com/mosaseka/Discord_ComputerNewsBot)
MAX_ARTICLE_BYTES=2097152
ARTICLE_FETCH_ENABLED=true
COMMAND_STATUS_PUBLIC=false
GEMINI_ENABLED=false
GEMINI_API_KEY=
